0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1460" y="1010" width="400" height="340" as="geometry"/></mxCell><mxCell id="lg_t" value="Legend" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="1014" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg_l0" value="PK – Primary Key (bold, underlined)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="1038" width="380" height="20" as="geometry"/></mxCell><mxCell id="lg_l1" value="FK – Foreign Key (italic); FK,UQ = unique FK (1:1)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="1058" width="380" height="20" as="geometry"/></mxCell><mxCell id="lg_l2" value="UQ – Unique constraint / composite unique key" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="1078" width="380" height="20" as="geometry"/></mxCell><mxCell id="lg_l3" value="Footer rows = composite UQ, CHECK and composite FK" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="1098" width="380" height="20" as="geometry"/></mxCell><mxCell id="lg_e0" style="endArrow=ERmandOne;endFill=0;endSize=12;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="1140" as="sourcePoint"/><mxPoint x="1570" y="1140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_et0" value="One (mandatory)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1585" y="1130" width="260" height="20" as="geometry"/></mxCell><mxCell id="lg_e1" style="endArrow=ERzeroToOne;endFill=0;endSize=12;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="1168" as="sourcePoint"/><mxPoint x="1570" y="1168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_et1" value="Zero or one" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1585" y="1158" width="260" height="20" as="geometry"/></mxCell><mxCell id="lg_e2" style="endArrow=ERzeroToMany;endFill=0;endSize=12;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="1196" as="sourcePoint"/><mxPoint x="1570" y="1196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_et2" value="Zero or many (crow's foot)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1585" y="1186" width="260" height="20" as="geometry"/></mxCell><mxCell id="lg_g" value="Entity header colour = module" style="text;html=1;fontStyle=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="1232" width="300" height="18" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1474" y="1256" width="22" height="12" as="geometry"/></mxCell><mxCell id="lg_st0" value="User &amp;amp; Profile Management" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1504" y="1252" width="340" height="18" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1474" y="1273" width="22" height="12" as="geometry"/></mxCell><mxCell id="lg_st1" value="Turf &amp;amp; Booking Management" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1504" y="1269" width="340" height="18" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1474" y="1290" width="22" height="12" as="geometry"/></mxCell><mxCell id="lg_st2" value="Team &amp;amp; Match Management" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1504" y="1286" width="340" height="18" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1474" y="1307" width="22" height="12" as="geometry"/></mxCell><mxCell id="lg_st3" value="Tournament Management" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1504" y="1303" width="340" height="18" as="geometry"/></mxCell><mxCell id="lg_s4" value="" style="fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1474" y="1324" width="22" height="12" as="geometry"/></mxCell><mxCell id="lg_st4" value="Notification &amp;amp; Review Management" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1504" y="1320" width="340" height="18" as="geometry"/></mxCell><mxCell id="panel" value="&lt;b&gt;Design Notes &amp;amp; Constraints&lt;/b&gt;&lt;br&gt;&lt;b&gt;A. One active booking per slot.&lt;/b&gt; BOOKING keeps history, but only one row per slot may have booking_status = CONFIRMED. PostgreSQL / SQL Server: filtered unique index on BOOKING(slot_id) WHERE booking_status = 'CONFIRMED'. MySQL has no partial index: use a generated column (slot_id if CONFIRMED, else NULL) with a UNIQUE index, or a trigger.&lt;br&gt;&lt;b&gt;B. Overlapping slots.&lt;/b&gt; UQ (turf_id, slot_date, start_time) only blocks identical start times. 10:00–11:00 and 10:30–11:30 would both be accepted, so reject an insert/update when new.start_time &amp;lt; existing.end_time AND new.end_time &amp;gt; existing.start_time for the same turf_id and slot_date (trigger or serialized transaction).&lt;br&gt;&lt;b&gt;C. Fixture integrity.&lt;/b&gt; Composite FKs (tournament_id, home_team_id) and (tournament_id, away_team_id) → TOURNAMENT_TEAM(tournament_id, team_id) force both teams to be registered in that tournament. CHECKs: home &amp;lt;&amp;gt; away; winner_team_id (nullable) must equal home or away.&lt;br&gt;&lt;b&gt;D. Availability consistency.&lt;/b&gt; TIME_SLOT.availability_status mirrors BOOKING.booking_status: update both in one transaction (or derive availability from bookings).&lt;br&gt;&lt;b&gt;E. Reviews.&lt;/b&gt; UQ (user_id, turf_id): one review per user per turf. Skill level is stored per sport in PLAYER_SPORT.&lt;br&gt;&lt;b&gt;F. SQL naming.&lt;/b&gt; USER and MATCH keep the names given in the brief; in SQL scripts use APP_USER and SPORTS_MATCH if the DBMS treats them as reserved words." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFDF5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="1640" width="1800" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>